# -----------------------------------------------------------------------------
# Environment variables template.
# Copy this file to ".env" and fill in your own values. NEVER commit the .env file.
# -----------------------------------------------------------------------------

# JSON-RPC endpoint for the Sepolia testnet.
# Get one free from https://infura.io or https://alchemy.com
SEPOLIA_RPC_URL="https://sepolia.infura.io/v3/YOUR_PROJECT_ID"

# Private key of the deploying account (the wallet that pays gas).
# Export from MetaMask: Account Details > Show private key.
# WARNING: use a throwaway test wallet, never your main account. No "0x" prefix needed.
PRIVATE_KEY="your_test_wallet_private_key_here"

# Etherscan API key, used to verify the contract source after deployment.
# Get one free from https://etherscan.io/myapikey
ETHERSCAN_API_KEY="your_etherscan_api_key_here"
